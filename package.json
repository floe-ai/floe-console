{
  "name": "floe-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A terminal client for the Floe substrate: see what actors are doing, send work in, and answer what actors ask.",
  "bin": {
    "floe-console": "./dist/main.js"
  },
  "floe": {
    "surface": {
      "name": "console",
      "label": "Floe Console",
      "bin": "floe-console"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "dev": "tsx src/main.tsx",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "floe": "github:floe-ai/floe#semver:^0.3.9",
    "ink": "^5.0.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
