{
  "name": "floe-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A terminal client for the Floe substrate: see what actors are doing, send work in, and answer what actors ask.",
  "bin": {
    "floe-console": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.tsx",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scure/bip39": "^1.3.0",
    "ink": "^5.0.1",
    "nostr-tools": "^2.25.2",
    "react": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
